      "may_claim_real_interview": false
    },
    {
      "id": "engineering_case",
      "name": "工程问题（Engineering Case）",
      "may_claim_real_interview": false
    },
    {
      "id": "secondary_index",
      "name": "二次索引（Secondary Index）",
      "may_claim_real_interview": false
    }
  ],
  "required_node_fields": [
    "id",
    "type",
    "label_zh",
    "label_en",
    "status",
    "reviewed_at",
    "source_refs"
  ],
  "optional_node_fields": [
    "abbreviation",
    "domain_ids",
    "module_ids",
