    "review_status"
  ],
  "node_id_patterns": {
    "backbone": "^BB-[A-Z0-9-]+$",
    "pipeline_stage": "^PS-[A-Z0-9-]+$",
    "knowledge": "^RAG-\\d{2}-\\d{3}$",
    "algorithm": "^ALG-[A-Z0-9-]+$",
    "capability": "^CAP-[A-Z0-9-]+$",
    "problem_question": "^PQ-RAG-\\d{4}$",
    "cause": "^CAUSE-RAG-\\d{4}$",
    "solution": "^SOL-RAG-\\d{4}$",
    "implementation": "^IMP-RAG-\\d{4}$",
    "evaluation": "^EVAL-[A-Z0-9-]+$",
    "source": "^SRC-[A-Z0-9-]+$"
  },
  "review_statuses": [
    "discovered",
    "inventory_draft",
    "source_mapped",
    "fact_checked",
    "content_draft",
    "reviewed",
    "superseded"
  ],
  "graph_invariants": [
    "Every non-source node must have at least one supported_by edge before reviewed status.",
    "Every problem_question node must have at least one problem_at edge.",
    "Every problem_question node must have provenance_type and source locator unless it is engineering_case.",
    "Every solution node must connect to at least one problem_question through solved_by or its inverse representation.",
    "Every implementation node must connect to a knowledge or solution node.",
    "Every formal learning view must reference node IDs from the graph.",
    "No unregistered edge type may be published.",
    "Undirected relationships must be normalized to a stable endpoint order to prevent duplicates."
  ],
  "example_subgraph": {
    "description": "向量数据库（Vector Database）与检索增强生成（Retrieval-Augmented Generation，RAG）的层级和重叠示例。",
    "nodes": [
      {"id": "BB-RAG", "type": "backbone", "label_zh": "检索增强生成", "label_en": "Retrieval-Augmented Generation"},
      {"id": "BB-VECTOR-DATABASE", "type": "backbone", "label_zh": "向量数据库", "label_en": "Vector Database"},
      {"id": "PS-STORAGE-INDEXING", "type": "pipeline_stage", "label_zh": "存储与索引", "label_en": "Storage and Indexing"},
      {"id": "CAP-VECTOR-INDEX", "type": "capability", "label_zh": "向量索引", "label_en": "Vector Index"},
      {"id": "CAP-ANN-SEARCH", "type": "capability", "label_zh": "近似最近邻检索", "label_en": "Approximate Nearest Neighbor Search"},
      {"id": "ALG-HNSW", "type": "algorithm", "label_zh": "分层可导航小世界图", "label_en": "Hierarchical Navigable Small World"}
    ],
    "edges": [
      {"type": "contains", "from": "BB-RAG", "to": "PS-STORAGE-INDEXING"},
      {"type": "overlaps_with", "from": "PS-STORAGE-INDEXING", "to": "BB-VECTOR-DATABASE"},
      {"type": "contains", "from": "BB-VECTOR-DATABASE", "to": "CAP-VECTOR-INDEX"},
      {"type": "contains", "from": "CAP-VECTOR-INDEX", "to": "CAP-ANN-SEARCH"},
      {"type": "implements", "from": "ALG-HNSW", "to": "CAP-ANN-SEARCH"}
    ]
  }
}

